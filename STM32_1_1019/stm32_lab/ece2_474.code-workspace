{
  "folders": [
    {
      "path": "."
    }
  ],
  "extensions": {
    "recommendations": [
      "STMicroelectronics.stm32-vscode-extension",
      "ms-vscode.vscode-serial-monitor"
    ]
  },
  "settings": {
    "stm32cube-ide-clangd.path": "cube",
    "stm32cube-ide-clangd.arguments": [
      "starm-clangd",
      "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gcc*",
      "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-g++*"
    ],
    "cmake.cmakePath": "C:/Users/samsung/AppData/Local/stm32cube/bundles/cmake/4.4.0+st.1/bin/cmake.exe",
    "cmake.configureArgs": [
      "-DCMAKE_MAKE_PROGRAM=C:/Users/samsung/AppData/Local/stm32cube/bundles/ninja/1.13.2+st.1/bin/ninja.exe"
    ],
    "cmake.preferredGenerators": [
      "Ninja"
    ],
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/stm32/Debug/compile_commands.json",
    "cmake.environment": {
      "PATH": "C:/Users/samsung/Documents/Codex/2026-10-11/e/work/stm32/arm_toolchain/bin/;C:/Users/samsung/AppData/Local/stm32cube/bundles/ninja/1.13.2+st.1/bin;${env:PATH}"
    },
    "cmake.useCMakePresets": "always"
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "stlinkgdbtarget",
        "request": "launch",
        "name": "STM32Cube: Launch ST-Link GDB Server",
        "origin": "snippet",
        "cwd": "${workspaceFolder}",
        "preBuild": "${command:st-stm32-ide-debug-launch.build}",
        "runEntry": "main",
        "serverCubeProgPath": "${command:st-stm32-ide-debug-launch.get-programmer-path}",
        "imagesAndSymbols": [
          {
            "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
          }
        ]
      }
    ]
  }
}